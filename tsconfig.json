{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@kitwongpixel/keplr-chain-button": [
        "packages/keplr-chain-button/src/index.ts"
      ]
    }
  },
  "include": ["src", "packages/keplr-chain-button/src"]
}
